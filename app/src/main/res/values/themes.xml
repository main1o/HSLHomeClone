<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HSLHome" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowBackground">@color/bg_gray</item>
        <item name="android:statusBarColor">@color/primary</item>
    </style>

    <style name="CardSection">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
